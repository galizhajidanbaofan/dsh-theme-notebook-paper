{
  "name": "dsh-theme-notebook-paper",
  "version": "1.0.1",
  "private": true,
  "description": "笔记本主题：把 DeepSeek Harness 桌面端铺成横线笔记本纸（朱红竖线分栏、白色手绘勾线气泡、手写批注式交互）",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-theme",
    "theme",
    "notebook",
    "desktop"
  ],
  "homepage": "https://github.com/galizhajidanbaofan/dsh-theme-notebook-paper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galizhajidanbaofan/dsh-theme-notebook-paper.git"
  },
  "bugs": {
    "url": "https://github.com/galizhajidanbaofan/dsh-theme-notebook-paper/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "README.md",
    "docs/IMPLEMENTATION.md",
    "assets/icon-180.png",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
